# 1. 떡의 개수와 손님이 요청한 목표 길이(M) 입력받기
떡개수, 목표길이 = map(int, input().split())

# 2. 떡들의 개별 높이 입력받기
떡높이들 = list(map(int, input().split()))

# 3. 이진 탐색(업다운 게임)을 위한 시작점과 끝점 설정
시작점 = 0
끝점 = max(떡높이들) # 가장 긴 떡의 길이를 끝점으로 설정

# 최댓값을 저장할 정답 변수
정답 = 0

# 4. 이진 탐색 시작! (시작점이 끝점보다 커지면 게임 끝)
while 시작점 <= 끝점:
    잘린떡_총합 = 0
    중간점 = (시작점 + 끝점) // 2  # 절단기 높이를 중간으로 설정 (업다운 게임의 '부르는 숫자')
    
    # 갖고 있는 떡들을 한 번씩 다 잘라봄
    for 떡 in 떡높이들:
        if 떡 > 중간점:  # 떡이 절단기보다 길 때만 잘림
            잘린떡_총합 = 잘린떡_총합 + (떡 - 중간점)
            
    # 조건 1: 잘린 떡이 손님이 원하는 양보다 적을 때 (더 많이 잘라야 함)
    if 잘린떡_총합 < 목표길이:
        끝점 = 중간점 - 1  # 절단기 높이를 낮춤 (Down!)
        
    # 조건 2: 잘린 떡이 손님이 원하는 양보다 많거나 같을 때 (일단 합격)
    else:
        정답 = 중간점      # 합격이니까 일단 이 높이를 정답으로 메모해둠
        시작점 = 중간점 + 1 # 근데 '최대한 덜 잘라서' 줘야 하니까 절단기 높이를 조금 더 높여봄 (Up!)

# 최종적으로 메모된 가장 높은 절단기 높이 출력
print(정답)