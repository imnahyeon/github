# 1. 숫자의 개수(N)와 바꿔치기 할 횟수(K) 입력받기
숫자개수, 바꿔치기횟수 = map(int, input().split())

# 2. 두 개의 숫자 묶음(배열 A와 B) 입력받기
배열A = list(map(int, input().split()))
배열B = list(map(int, input().split()))

# 3. 레퍼런스의 '정렬' 기능 사용하기!
# A는 작은 숫자가 맨 앞으로 오도록 줄 세우기 (오름차순)
배열A.sort()

# B는 큰 숫자가 맨 앞으로 오도록 줄 세우기 (내림차순)
배열B.sort(reverse=True)

# 4. 정해진 횟수만큼 차례대로 비교하며 바꿔치기
for i in range(바꿔치기횟수):
    # A의 숫자가 B의 숫자보다 작을 때만 서로 자리를 바꿈
    if 배열A[i] < 배열B[i]:
        배열A[i], 배열B[i] = 배열B[i], 배열A[i]
    else:
        # A의 숫자가 B의 숫자보다 크거나 같아지면 멈춤 (더 바꿀 필요 없음)
        break

# 5. 파이썬 기본 함수를 사용하여 배열 A의 모든 숫자 합계 출력
print(sum(배열A))